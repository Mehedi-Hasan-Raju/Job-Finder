# Example environment configuration
# Copy this file to .env and update the values for your environment
# Note: In Vite, environment variables must be prefixed with VITE_ to be exposed to client code

# API Base URL - determines which API endpoint the frontend communicates with
# For local development: http://localhost:4000/api/v1
# For production: your production backend URL (e.g., https://your-api.com/api/v1)
VITE_API_URL=http://localhost:4000/api/v1
